# ─────────────────────────────────────────────────────────────
# Variables de entorno del backend de TOTH
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas el .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# Groq (LLM) — https://console.groq.com/keys
GROQ_API_KEY=

# Supabase (fondo documental vectorial / pgvector)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Búsqueda web de complemento (opcional) — https://tavily.com
TAVILY_API_KEY=

# Umbral de similitud coseno para activar el fallback web (0–1)
SIMILARITY_THRESHOLD=0.85

# Entorno de ejecución
NODE_ENV=development

# Firebase Project ID (trazabilidad y autenticación)
FIREBASE_PROJECT_ID=
