# Variables públicas inyectadas en el bundle por babel.config.js.
# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` a Git.

# Firebase Web API Key (Project Settings > General > Web API Key)
FIREBASE_API_KEY=

# Firebase Project ID (Project Settings > General > Project ID)
FIREBASE_PROJECT_ID=

# Backend TOTH. Producción por defecto; para backend local en emulador:
# API_BASE_URL=http://10.0.2.2:3000
API_BASE_URL=https://thoth-backend.vercel.app
